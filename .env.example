# Email Provider (Resend)
# Get your API key at https://resend.com/api-keys
EMAIL_API_KEY=

# Studio inquiry recipient
CONTACT_TO_EMAIL=haftechhq@gmail.com

# Verified sender on Resend (use onboarding@resend.dev during testing, then your domain e.g. studio@haftech.site)
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Cloudflare Turnstile bot verification (optional)
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Site URLs & Environment Flags
NEXT_PUBLIC_SITE_URL=https://haftech.site
NEXT_PUBLIC_SHOW_UNVERIFIED=false

# Optional WhatsApp direct brief routing (international digits only, e.g. 2348012345678)
NEXT_PUBLIC_WHATSAPP_NUMBER=
